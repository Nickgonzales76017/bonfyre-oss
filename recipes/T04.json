{
  "code": "T04",
  "name": "Topic Mapper Collapse",
  "version": "1.2.0",
  "description": "Production collapse recipe for topic mapping. Uses Python synth teachers (dataset labels + sentence-transformers/MiniLM) validated across 8 corpus×scale combinations (F1 0.847–0.968, stability 0.895). Gate: f1_vs_consensus >= 0.85, latency_ratio <= 0.30.",
  "status": "production",
  "geometry": "global",
  "transform_family": "T04",
  "gate": { "f1_vs_consensus": 0.85, "latency_ratio": 0.30 },
  "72run_stats": { "mean_f1": 0.914, "pass_rate": "10/10", "stability": 0.895 },
  "stages": [
    {
      "id": "tag",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_tags.py",
        "{input}",
        "{out}/tag"
      ],
      "depends_on": []
    },
    {
      "id": "embed",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_embed.py",
        "{input}",
        "{out}/embed",
        "--model", "all-MiniLM-L6-v2"
      ],
      "depends_on": []
    },
    {
      "id": "train",
      "bin": "python3",
      "args": [
        "scripts/collapse_train.py",
        "--task",      "topic-map",
        "--tag-dir",   "{out}/tag",
        "--embed-dir", "{out}/embed",
        "--out",       "{out}/train"
      ],
      "depends_on": ["tag", "embed"]
    },
    {
      "id": "finalize",
      "bin": "python3",
      "args": ["scripts/finalize_artifact.py", "{out}/train"],
      "depends_on": ["train"]
    }
  ]
}
