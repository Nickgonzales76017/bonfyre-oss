{
  "code": "T04",
  "name": "Topic Mapper Collapse",
  "version": "1.1.0",
  "description": "Production collapse recipe for topic mapping. Uses Python synth teachers (dataset labels + sentence-transformers/MiniLM) validated across 8 corpus×scale combinations (F1 0.847–0.964, stability 0.867). Gate: f1_vs_consensus >= 0.80, latency_ratio <= 0.30.",
  "stages": [
    {
      "id": "tag",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_tags.py",
        "{input}",
        "{out}/tag"
      ],
      "depends_on": []
    },
    {
      "id": "embed",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_embed.py",
        "{input}",
        "{out}/embed",
        "--model", "all-MiniLM-L6-v2"
      ],
      "depends_on": []
    },
    {
      "id": "train",
      "bin": "python3",
      "args": [
        "scripts/collapse_train.py",
        "--task",      "topic-map",
        "--tag-dir",   "{out}/tag",
        "--embed-dir", "{out}/embed",
        "--out",       "{out}/train"
      ],
      "depends_on": ["tag", "embed"]
    },
    {
      "id": "quant-verify",
      "bin": "bonfyre-quant",
      "args": ["roundtrip", "{out}/train/model.onnx", "--bits", "3"],
      "depends_on": ["train"]
    },
    {
      "id": "hash",
      "bin": "bonfyre-hash",
      "args": ["merkle", "{out}/train/artifact.json"],
      "depends_on": ["quant-verify"]
    }
  ]
}
