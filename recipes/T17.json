{
  "code": "T17",
  "name": "Readability Complexity Collapse",
  "version": "1.0.0",
  "description": "Production: pure-Python readability feature extraction (avg sentence len, word len, type-token ratio, punct density, long-word ratio, sentence count) → MiniBatchKMeans complexity clusters → MiniLM embeddings → collapse to ONNX topic-map student. Zero external ML dependencies for the teacher stage. Promoted from diversity run if F1 >= 0.85 across corpora.",
  "geometry": "pending",
  "status": "calibration",
  "stages": [
    {
      "id": "readability",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_readability.py",
        "{input}",
        "{out}/readability",
        "--k", "5"
      ],
      "depends_on": []
    },
    {
      "id": "embed",
      "bin": "python3",
      "args": [
        "scripts/synth_teacher_embed.py",
        "{input}",
        "{out}/embed",
        "--model", "all-MiniLM-L6-v2"
      ],
      "depends_on": []
    },
    {
      "id": "train",
      "bin": "python3",
      "args": [
        "scripts/collapse_train.py",
        "--task",      "topic-map",
        "--tag-dir",   "{out}/readability",
        "--embed-dir", "{out}/embed",
        "--out",       "{out}/train"
      ],
      "depends_on": ["readability", "embed"]
    },
    {
      "id": "finalize",
      "bin": "python3",
      "args": [
        "scripts/finalize_artifact.py",
        "{out}/train"
      ],
      "depends_on": ["train"]
    }
  ]
}
